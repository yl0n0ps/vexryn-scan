{
  "mcpServers": {
    "slack": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      }
    },
    "files": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "~"
      ]
    },
    "internal-docs": {
      "type": "http",
      "url": "http://docs.internal.example.com/mcp"
    },
    "web": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    }
  }
}
